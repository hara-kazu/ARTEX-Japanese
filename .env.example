# Docker 用の設定（.env にコピー）
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# 非公開 GitHub Release の更新（バックエンドのみ参照。hara-kazu/ARTEX-Japanese の Contents: read 権限が必要）
ARTEX_UPDATE_GITHUB_TOKEN=

# LLM（どちらか一方、または両方を設定。空欄にして画面から設定することも可能）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
